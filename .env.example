DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=portfolioddd
JWT_SECRET=
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Vite only exposes VITE_-prefixed vars to the frontend build
VITE_API_URL=http://localhost:3001

# Public site origin, used for canonical URLs, sitemap and link previews
# PUBLIC_URL=https://example.com

# Outgoing email (verification, password reset, notifications).
# Without SMTP_URL or SMTP_HOST, emails are only printed to the backend console.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM="PortfolioDDD <no-reply@example.com>"

# File storage: "local" (./uploads) or "s3" (any S3-compatible bucket)
STORAGE_DRIVER=local
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# CDN_BASE_URL=

# Model pipeline
# MAX_MODEL_UPLOAD_MB=300
# MODEL_COMPRESSION=meshopt
# MODEL_MAX_TEXTURE_SIZE=4096
# BLENDER_PATH=
