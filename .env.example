DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=portfolioddd
JWT_SECRET=
# Encrypts direct messages at rest (falls back to JWT_SECRET). Set it in
# production and never change it, or older messages become unreadable.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MESSAGE_ENCRYPTION_KEY=
# Messages, comments, job posts and purchase requests need a confirmed email
# address. Recommended in production (needs SMTP below).
# REQUIRE_EMAIL_VERIFICATION=true
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Vite only exposes VITE_-prefixed vars to the frontend build
VITE_API_URL=http://localhost:3001

# Public site origin, used for canonical URLs, sitemap and link previews
# PUBLIC_URL=https://example.com

# Outgoing email (verification, password reset, notifications).
# Without SMTP_URL or SMTP_HOST, emails are only printed to the backend console.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM="PortfolioDDD <no-reply@example.com>"

# File storage: "local" (./uploads) or "s3" (any S3-compatible bucket)
STORAGE_DRIVER=local
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# CDN_BASE_URL=

# Behind a reverse proxy (Render, Fly, nginx, a load balancer): how many
# proxies are in front, so rate limits see each visitor's own address.
# Set TRUST_PROXY=1 on a typical host; leave unset when nothing is in front.
# TRUST_PROXY=1

# Storage each account may use in total (models, images, videos, renders,
# avatar, cover). An account's own users.storage_quota_bytes overrides it.
# STORAGE_QUOTA_MB=250

# Per-file limits for 2D artwork images and for videos (artworks and renders).
# Render images, covers, avatars and thumbnails are capped at 5 MB.
# MAX_IMAGE_UPLOAD_MB=10
# MAX_VIDEO_UPLOAD_MB=30

# Model pipeline
# MAX_MODEL_UPLOAD_MB=50
# MODEL_COMPRESSION=meshopt
# MODEL_MAX_TEXTURE_SIZE=4096
